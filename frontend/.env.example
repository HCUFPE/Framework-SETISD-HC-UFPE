# ==============================================================================
# SAE-HC: MODELO DE VARIÁVEIS DE AMBIENTE DO FRONTEND (.env.example)
# ==============================================================================
# Copie para frontend/.env para sobrescrever os padrões locais.
# Nunca comite o arquivo preenchido (ele é ignorado via .gitignore).

# Usa fixtures locais em memória no lugar da API REST.
# true  -> mocks ativos (entrega atual de telas)
# false -> chamadas reais para os endpoints documentados em docs/especificacao/05-interfaces.md
VITE_USE_MOCKS=true
