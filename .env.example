# ==============================================================================
# FRAMEWORK-SETISD-HC-UFPE: MODELO DE VARIÁVEIS DE AMBIENTE (.env.example)
# ==============================================================================
# INSTRUÇÕES:
# 1. Copie este arquivo para um novo arquivo chamado '.env' na raiz do projeto.
# 2. Preencha os valores reais correspondentes ao seu ambiente (Desenvolvimento/Produção).
# 3. NUNCA comite o arquivo '.env' preenchido no Git (ele é ignorado via .gitignore).
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. CONFIGURAÇÕES DO SERVIDOR & AMBIENTE
# ------------------------------------------------------------------------------
# Qual o ambiente de execução? Opções: development, production
ENV=development

# Nível de log do sistema. Opções: debug, info, warning, error
LOG_LEVEL=info

# Domínios permitidos para requisições Cross-Origin (CORS), separados por vírgula.
# Use '*' apenas em desenvolvimento local. Em produção, especifique o domínio/IP ex: http://10.34.0.192
ALLOWED_ORIGINS=*

# ------------------------------------------------------------------------------
# 2. PROVEDOR DE DADOS (DOMÍNIOS DE NEGÓCIO)
# ------------------------------------------------------------------------------
# Define a fonte de dados padrão para o módulo de Pacientes. Opções: POSTGRES, CSV
PACIENTE_PROVIDER_TYPE=POSTGRES

# ------------------------------------------------------------------------------
# 3. BANCOS DE DADOS
# ------------------------------------------------------------------------------
# Banco de dados SQLite local da aplicação (armazena usuários autorizados e refresh tokens)
# Guardado na pasta data/ para manter a raiz limpa
APP_DB_URL=sqlite+aiosqlite:///data/app.db

# Banco de dados AGHU (PostgreSQL) - Preencha com a DSN do seu ambiente
POSTGRES_DSN=postgresql+asyncpg://usuario_exemplo:senha_exemplo@host_servidor:5432/nome_banco

# Banco de dados AGHU (Oracle) - Opcional se sua unidade utilizar Oracle
ORACLE_DSN=oracle+oracledb://usuario_exemplo:senha_exemplo@host_servidor:1521/nome_servico

# ------------------------------------------------------------------------------
# 4. AUTENTICAÇÃO CORPORATIVA (ACTIVE DIRECTORY / LDAP)
# ------------------------------------------------------------------------------
# Descomente e preencha a AD_URL em ambiente de produção na rede Ebserh.
# Quando comentada, o sistema assume automaticamente o provedor Mock (offline).
# AD_URL=ldap://seu-servidor-ad.ebserhnet.ebserh.gov.br:389

# Árvore base para busca de usuários e grupos corporativos no AD
AD_BASEDN="DC=ebserhnet,DC=gov,DC=br"

# Opcional: Conta de serviço para busca de grupos no AD (se a consulta exigir privilégios)
AD_BIND_USER=EBSERHNET\usuario_servico_exemplo
AD_BIND_PASSWORD=senha_conta_servico_exemplo

# ------------------------------------------------------------------------------
# 5. SEGURANÇA E CRIPTOGRAFIA (JWT & COOKIES)
# ------------------------------------------------------------------------------
# Chave secreta usada para assinar os tokens JWT.
# ATENÇÃO: Altere para uma string aleatória forte em ambiente de produção!
JWT_SECRET=SUA_CHAVE_SECRETA_SUPER_FORTE_AQUI_ALTERAR_EM_PRODUCAO

# Tempo de expiração do Access Token (em horas)
JWT_EXP_HOURS=24

# Tempo de expiração do Refresh Token em Cookie HttpOnly (em dias)
REFRESH_TOKEN_EXP_DAYS=30
